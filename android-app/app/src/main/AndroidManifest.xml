<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uniquement les permissions qui servent (§ 1, 🔄 D19). -->
    <!-- Minuteur de repos et rappels (demandée à l'exécution, Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmes exactes : accordée d'office sous Android 13+ (acceptable hors Play Store). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Alarmes exactes sous Android 12 – 12L. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Vibration de fin de repos depuis le récepteur d'alarme. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Live Update de la séance en cours (Android 16+, § 15.5, 🔄 D31) : permission normale, sans
         demande ; l'utilisateur peut la couper dans les réglages de notification de l'app. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Reprogrammer les rappels de compléments après un redémarrage. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Vérification des mises à jour (§ 3.17, 🔄 D25) : une requête par jour à l'API GitHub,
         seulement si l'app n'est pas installée par Obtainium ; aucune donnée envoyée.
         Envoi d'un avis (§ 14, 🔄 D26) : seulement quand l'utilisateur appuie sur « Envoyer ». -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sauvegarde automatique (§ 15.2, 🔄 D28) : WorkManager déclare aussi WAKE_LOCK (gardée) et
         RECEIVE_BOOT_COMPLETED (déjà là). La tâche n'a ni contrainte réseau ni travail au premier
         plan : les deux permissions suivantes, ajoutées par WorkManager, sont retirées. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <!-- Health Connect (§ 15.3, 🔄 D29) : écriture des séances et du poids, accordée dans l'écran
         de Health Connect quand l'utilisateur active l'option. Aucune permission de lecture. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- App Health Connect (Android 8 à 13 ; intégrée au système depuis Android 14). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".MuscleNoteApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuscleNote"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sauvegarde partagée depuis l'app Expo ou une autre app (§ 5.4, § 5.5). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <!-- Fichier JSON ouvert avec MuscleNote depuis un gestionnaire de fichiers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Politique de confidentialité exigée par Health Connect (§ 15.3) : sans elle, la demande
          d'autorisation ne s'affiche pas. Android 13 et moins : ACTION_SHOW_PERMISSIONS_RATIONALE.
        -->
        <activity
            android:name=".health.HealthPermissionsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14 et plus : VIEW_PERMISSION_USAGE + HEALTH_PERMISSIONS, réservé au système. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.HealthPermissionsActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Minuteur de repos (§ 7.2) : alarme de fin et action « Passer », intents explicites. -->
        <receiver
            android:name=".notifications.RestTimerReceiver"
            android:exported="false" />

        <!-- Rappels de compléments (§ 7.3) : sonnerie d'un rappel, intent explicite. -->
        <receiver
            android:name=".notifications.SupplementReminderReceiver"
            android:exported="false" />

        <!--
          Resynchronisation des rappels : diffusions du système, reçues même non exporté.
          Toutes figurent parmi les exceptions aux restrictions des diffusions implicites.
        -->
        <receiver
            android:name=".notifications.ReminderResyncReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Partage des exports (§ 5.6) sans permission de stockage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Langue par application (§ 9.4) : AppCompat mémorise le choix sous Android 13. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
